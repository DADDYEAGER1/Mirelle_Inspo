      "path": "src/app/authors/[slug]/page.tsx",
      "content": "// src/app/authors/[slug]/page.tsx\n\nimport { notFound } from 'next/navigation';\nimport { Metadata } from 'next';\nimport Image from 'next/image';\nimport Link from 'next/link';\nimport { getAuthor, getAllAuthors, getPostsByAuthor } from '@/lib/authors';\nimport AuthorPostsList from './AuthorPostsList';\n\ninterface PageProps {\n  params: Promise<{ slug: string }>;\n}\n\nexport const dynamic = 'force-static'\nexport const revalidate = false\n\nexport async function generateStaticParams() {\n  const authors = getAllAuthors();\n  return authors.map((a) => ({ slug: a.slug }));\n}\n\n\nexport async function generateMetadata({ params }: { params: Promise<{ slug: string }> }): Promise<Metadata> {\n  const { slug } = await params;\n  const author = getAuthor(slug);\n \n  if (!author) {\n    return {\n      title: 'Author Not Found',\n      robots: { index: false, follow: false },\n    };\n  }\n \n  const authorUrl = `https://mirelleinspo.com/authors/${author.slug}`;\n  const imageUrl = author.image ? `https://mirelleinspo.com${author.image}` : 'https://mirelleinspo.com/logo.png';\n \n  return {\n    title: `${author.displayName}  ${author.role}`,\n    description: author.bio,\n    authors: [{ name: author.fullName, url: authorUrl }],\n    creator: author.fullName,\n    alternates: { canonical: authorUrl },\n    openGraph: {\n      title: `${author.fullName}  ${author.role} at Mirellé Inspo`,\n      description: author.bio,\n      type: 'profile',\n      url: authorUrl,\n      siteName: 'Mirellé Inspo',\n      locale: 'en_US',\n      images: [{ url: imageUrl, width: 400, height: 400, alt: `${author.fullName}  ${author.role} at Mirellé Inspo` }],\n    },\n    twitter: {\n      card: 'summary',\n      title: `${author.fullName}  ${author.role} at Mirellé Inspo`,\n      description: author.bio,\n      creator: '@mirelleinspo',\n      site: '@mirelleinspo',\n      images: [imageUrl],\n    },\n    robots: {\n      index: true,\n      follow: true,\n      googleBot: { index: true, follow: true, 'max-image-preview': 'large', 'max-snippet': -1 },\n    },\n  };\n}\n \n// SVG icons  inline, no external dependency\nfunction InstagramIcon() {\n  return (\n    <svg\n      xmlns=\"http://www.w3.org/2000/svg\"\n      width=\"18\"\n      height=\"18\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      strokeWidth=\"1.5\"\n      strokeLinecap=\"round\"\n      strokeLinejoin=\"round\"\n      aria-hidden=\"true\"\n    >\n      <rect x=\"2\" y=\"2\" width=\"20\" height=\"20\" rx=\"5\" ry=\"5\" />\n      <circle cx=\"12\" cy=\"12\" r=\"4\" />\n      <circle cx=\"17.5\" cy=\"6.5\" r=\"0.5\" fill=\"currentColor\" stroke=\"none\" />\n    </svg>\n  );\n}\n\nfunction LinkedInIcon() {\n  return (\n    <svg\n      xmlns=\"http://www.w3.org/2000/svg\"\n      width=\"18\"\n      height=\"18\"\n      viewBox=\"0 0 24 24\"\n      fill=\"currentColor\"\n      aria-hidden=\"true\"\n    >\n      <path d=\"M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z\" />\n      <rect x=\"2\" y=\"9\" width=\"4\" height=\"12\" />\n      <circle cx=\"4\" cy=\"4\" r=\"2\" />\n    </svg>\n  );\n}\n\nexport default async function AuthorPage({ params }: PageProps) {\n  const { slug } = await params;\n\n  const author = getAuthor(slug);\n  if (!author) notFound();\n\n  const posts = await getPostsByAuthor(slug);\n\n  const personSchema = {\n    '@context': 'https://schema.org',\n    '@type': 'Person',\n    name: author.displayName,\n    jobTitle: author.role,\n    description: author.bio,\n    url: `https://mirelleinspo.com/authors/${slug}`,\n    image: `https://mirelleinspo.com${author.image}`,\n    worksFor: {\n      '@type': 'Organization',\n      name: 'Mirellé Inspo',\n      url: 'https://mirelleinspo.com',\n    },\n  };\n\n  return (\n    <>\n      <script\n        type=\"application/ld+json\"\n        dangerouslySetInnerHTML={{ __html: JSON.stringify(personSchema) }}\n      />\n\n      <div className=\"min-h-screen bg-background\">\n\n        {/* Hero */}\n        <section className=\"py-24 border-b border-foreground/10\">\n          <div className=\"max-w-4xl mx-auto px-6 sm:px-8 lg:px-12\">\n            <div className=\"grid grid-cols-1 md:grid-cols-[280px_1fr] gap-12 items-start\">\n\n              <div className=\"relative w-full pb-[100%] md:pb-0 md:h-[320px] overflow-hidden\">\n                <Image\n                  src={author.image}\n                  alt={author.displayName}\n                  fill\n                  className=\"object-cover\"\n                  sizes=\"(max-width: 768px) 100vw, 280px\"\n                  priority\n                />\n              </div>\n\n              <div className=\"flex flex-col justify-center space-y-4\">\n                <p className=\"font-ui text-xs uppercase tracking-widest text-foreground/50\">\n                  {author.role}\n                </p>\n                <h1\n                  className=\"text-5xl md:text-6xl text-foreground\"\n                  style={{ fontFamily: 'Larken, Georgia, serif' }}\n                >\n                  {author.displayName}\n                </h1>\n                <p\n                  className=\"text-xl text-foreground/70 leading-relaxed\"\n                  style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n                >\n                  {author.longBio}\n                </p>\n\n                {/* Social icons */}\n                {(author.instagram || author.linkedin) && (\n                  <div className=\"flex gap-4 pt-2\">\n                    {author.instagram && (\n                      <a\n                        href={author.instagram}\n                        target=\"_blank\"\n                        rel=\"noopener noreferrer\"\n                        aria-label={`${author.displayName} on Instagram`}\n                        className=\"flex items-center justify-center text-foreground/50 hover:text-foreground transition-colors duration-200\"\n                      >\n                        <InstagramIcon />\n                      </a>\n                    )}\n                    {author.linkedin && (\n                      <a\n                        href={author.linkedin}\n                        target=\"_blank\"\n                        rel=\"noopener noreferrer\"\n                        aria-label={`${author.displayName} on LinkedIn`}\n                        className=\"flex items-center justify-center text-foreground/50 hover:text-foreground transition-colors duration-200\"\n                      >\n                        <LinkedInIcon />\n                      </a>\n                    )}\n                  </div>\n                )}\n\n                <p className=\"font-ui text-xs uppercase tracking-widest text-foreground/40 pt-2\">\n                  {posts.length} {posts.length === 1 ? 'article' : 'articles'} published\n                </p>\n              </div>\n\n            </div>\n          </div>\n        </section>\n\n        {/* Posts */}\n        <section className=\"py-20\">\n          <div className=\"max-w-4xl mx-auto px-6 sm:px-8 lg:px-12\">\n            <h2\n              className=\"text-3xl md:text-4xl text-foreground mb-12\"\n              style={{ fontFamily: 'Larken, Georgia, serif' }}\n            >\n              Articles by {author.displayName}\n            </h2>\n\n            {posts.length === 0 ? (\n              <p\n                className=\"text-foreground/50 text-lg\"\n                style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n              >\n                Articles coming soon.\n              </p>\n            ) : (\n              <AuthorPostsList posts={posts} authorName={author.displayName} />\n            )}\n          </div>\n        </section>\n\n        {/* Back to team */}\n        <section className=\"py-12 border-t border-foreground/10\">\n          <div className=\"max-w-4xl mx-auto px-6 sm:px-8 lg:px-12\">\n            <Link\n              href=\"/authors\"\n              className=\"font-ui text-sm uppercase tracking-wide underline hover:no-underline text-foreground transition-opacity hover:opacity-70\"\n            >\n              Meet the full team\n            </Link>\n          </div>\n        </section>\n\n      </div>\n    </>\n  );\n}"
    },
    {
      "path": "src/app/authors/[slug]/AuthorPostsList.tsx",
      "content": "'use client';\n\nimport { useState } from 'react';\nimport Image from 'next/image';\nimport Link from 'next/link';\n\nconst TYPE_LABELS: Record<string, string> = {\n  blog:        'Blog',\n  faq:         'FAQ',\n  'work-nail': 'Work Nails',\n  spotlight:   'Spotlight',\n  topic:       'Topic',\n  report:      'Trend Report',\n  business:    'Business',\n};\n\ninterface Post {\n  slug: string;\n  title: string;\n  excerpt: string;\n  date: string;\n  image?: string;\n  type: string;\n  url: string;\n}\n\ninterface AuthorPostsListProps {\n  posts: Post[];\n  authorName: string;\n}\n\nconst PAGE_SIZE = 10;\n\nexport default function AuthorPostsList({ posts }: AuthorPostsListProps) {\n  const [page, setPage] = useState(1);\n\n  const totalPages = Math.ceil(posts.length / PAGE_SIZE);\n  const start = (page - 1) * PAGE_SIZE;\n  const shown = posts.slice(start, start + PAGE_SIZE);\n\n  function scrollToTop() {\n    window.scrollTo({ top: 0, behavior: 'smooth' });\n  }\n\n  function goTo(p: number) {\n    setPage(p);\n    scrollToTop();\n  }\n\n  return (\n    <>\n      <div className=\"divide-y divide-foreground/10\">\n        {shown.map((post) => (\n          <Link\n            key={`${post.type}-${post.slug}`}\n            href={post.url}\n            className=\"group flex items-start gap-6 py-8 transition-opacity hover:opacity-70\"\n          >\n            {post.image && (\n              <div className=\"relative w-20 h-20 flex-shrink-0 overflow-hidden\">\n                <Image\n                  src={post.image}\n                  alt={post.title}\n                  fill\n                  className=\"object-cover\"\n                  sizes=\"80px\"\n                />\n              </div>\n            )}\n            <div className=\"flex-1 space-y-1\">\n              <p className=\"font-ui text-xs uppercase tracking-widest text-foreground/40\">\n                {TYPE_LABELS[post.type] || post.type}\n              </p>\n              <h3\n                className=\"text-xl md:text-2xl text-foreground leading-snug\"\n                style={{ fontFamily: 'Larken, Georgia, serif' }}\n              >\n                {post.title}\n              </h3>\n              {post.excerpt && (\n                <p\n                  className=\"text-base text-foreground/60 line-clamp-2\"\n                  style={{ fontFamily: 'Crimson Text, Georgia, serif' }}\n                >\n                  {post.excerpt}\n                </p>\n              )}\n              <p className=\"font-ui text-xs text-foreground/40 pt-1\">\n                {new Date(post.date).toLocaleDateString('en-US', {\n                  year: 'numeric',\n                  month: 'long',\n                  day: 'numeric',\n                })}\n              </p>\n            </div>\n          </Link>\n        ))}\n      </div>\n\n      {/* Pagination */}\n      {totalPages > 1 && (\n        <div className=\"mt-16 flex flex-col items-center gap-6\">\n\n          {/* Page numbers */}\n          <div className=\"flex items-center gap-1\">\n            {/* Prev */}\n            <button\n              onClick={() => goTo(page - 1)}\n              disabled={page === 1}\n              className=\"w-9 h-9 flex items-center justify-center border border-foreground/20 font-ui text-xs text-foreground/60 hover:text-foreground hover:border-foreground transition-colors duration-200 disabled:opacity-20 disabled:cursor-not-allowed\"\n              aria-label=\"Previous page\"\n            >\n              ←\n            </button>\n\n            {/* Page buttons  show max 5 around current */}\n            {Array.from({ length: totalPages }, (_, i) => i + 1)\n              .filter(p => p === 1 || p === totalPages || Math.abs(p - page) <= 2)\n              .reduce<(number | 'ellipsis')[]>((acc, p, idx, arr) => {\n                if (idx > 0 && p - (arr[idx - 1] as number) > 1) acc.push('ellipsis');\n                acc.push(p);\n                return acc;\n              }, [])\n              .map((item, idx) =>\n                item === 'ellipsis' ? (\n                  <span\n                    key={`ellipsis-${idx}`}\n                    className=\"w-9 h-9 flex items-center justify-center font-ui text-xs text-foreground/30\"\n                  >\n                    ...\n                  </span>\n                ) : (\n                  <button\n                    key={item}\n                    onClick={() => goTo(item as number)}\n                    className={`w-9 h-9 flex items-center justify-center border font-ui text-xs transition-colors duration-200 ${\n                      page === item\n                        ? 'border-foreground bg-foreground text-background'\n                        : 'border-foreground/20 text-foreground/60 hover:text-foreground hover:border-foreground'\n                    }`}\n                    aria-label={`Page ${item}`}\n                    aria-current={page === item ? 'page' : undefined}\n                  >\n                    {item}\n                  </button>\n                )\n              )}\n\n            {/* Next */}\n            <button\n              onClick={() => goTo(page + 1)}\n              disabled={page === totalPages}\n              className=\"w-9 h-9 flex items-center justify-center border border-foreground/20 font-ui text-xs text-foreground/60 hover:text-foreground hover:border-foreground transition-colors duration-200 disabled:opacity-20 disabled:cursor-not-allowed\"\n              aria-label=\"Next page\"\n            >\n              →\n            </button>\n          </div>\n\n          {/* Count */}\n          <p className=\"font-ui text-xs text-foreground/40\">\n            {start + 1} to {Math.min(start + PAGE_SIZE, posts.length)} of {posts.length} articles\n          </p>\n\n        </div>\n      )}\n    </>\n  );\n}"
    },
    {
      "path": "src/types/author.ts",
      "content": "// src/types/author.ts\n\nexport interface Author {\n  slug: string;\n  fullName: string;          // real legal name  used in schema\n  displayName: string;       // short name used in UI e.g. \"Jyoti\"\n  role: string;              // job title for schema jobTitle field\n  bio: string;               // 2-3 sentences  AuthorCard, blog posts\n  longBio: string;           // full bio  /authors/[slug] page\n  image: string;             // e.g. /images/team/ri-mirelle.webp\n  authorPageUrl: string;     // canonical author page URL\n  instagram?: string;\n  linkedin?: string;\n  youtube?: string;\n  twitter?: string;\n  knowsAbout: string[];      // schema knowsAbout topics array\n}\n\nexport interface AuthorWithStats extends Author {\n  postCount: number;\n}"
    },
    {
      "path": "src/types/blog.ts",
      "content": "// src/types/blog.ts\nimport { FAQItem, TutorialStep, VideoMetadata } from '@/lib/generateSchemas';\n\nexport interface TutorialMetadata {\n  name: string;\n  description: string;\n  totalTime: string;\n  estimatedCost: {\n    currency: string;\n    value: string;\n  };\n  tools: string[];\n  supplies: string[];\n}\n\nexport interface TLDR {\n  summary: string[];\n  tldrFaqs?: FAQ[];\n  creativeLine?: string;\n  keyTakeaways?: string[];\n}\n\nexport interface FAQ {\n  question: string;\n  answer: string;\n}\n\nexport interface Product {\n  image: string;\n  name?: string;\n  title?: string;\n  price: string;\n  link?: string;\n  url?: string;\n  brand?: string;\n  details?: string[];\n}\n\nexport interface BlogMetadata {\n  slug: string;\n  title: string;\n  excerpt: string;\n  tags?: string[];\n  image?: string;\n  imageAlt?: string;\n  imageWidth?: number;\n  imageHeight?: number;\n  imageCaption?: string;\n  dateModified?: string;\n  url: string;\n  topicalMap?: any;\n  navigationContext?: NavigationContext;\n  topic?: string;\n  tldr?: TLDR;\n  faqItems?: FAQItem[];\n  eventData?: {\n    name: string;\n    startDate: string;\n    endDate: string;\n    eventStatus: string;\n    eventAttendanceMode: string;\n    isVirtual: boolean;\n  };\n\n  date: string;\n  author: string;\n  readTime: number | string;\n  category?: string;\n  canonical?: string;\n  updatedDate?: string;\n  wordCount?: number;\n\n  template?: 'center' | 'split-left' | 'split-right' | 'grid';\n  heroImages?: string[];\n  carouselImages?: { url: string; alt: string }[];\n  products?: Product[];\n\n  // Controls whether the \"Explore {topic} inspiration gallery\" link is\n  // auto-injected after body images. Only relevant when `topic` is set.\n  // Defaults to true if omitted.\n  showInspoGalleryLink?: boolean;\n}\n\nexport interface TopicalMap {\n  position: 'pillar' | 'cluster' | 'standalone';\n  parentPillar: string | null;\n  relatedClusters: string[];\n  primaryKeyword: string;\n  searchIntent: 'informational' | 'transactional' | 'navigational' | 'commercial';\n  topicalBoundary: string;\n  hierarchyLevel: number;\n\n  secondaryKeywords?: string[];\n  contentType?: 'tutorial' | 'guide' | 'comparison' | 'showcase' | 'trend-analysis';\n  semanticRelationships?: {\n    technique?: string[];\n    style?: string[];\n    occasions?: string[];\n    relatedTechniques?: string[];\n  };\n  contentMetrics?: {\n    technicalComplexity?: 'beginner' | 'intermediate' | 'advanced';\n    timeToImplement?: string;\n    requiredSkills?: string[];\n    requiredTools?: string[];\n  };\n  childClusters?: Array<{\n    slug: string;\n    relationship?: string;\n    hierarchyLevel?: number;\n  }>;\n}\n\nexport interface NavigationContext {\n  pillarPost?: {\n    slug: string;\n    title: string;\n  };\n  previousPost?: {\n    slug: string;\n    title: string;\n  };\n  nextPost?: {\n    slug: string;\n    title: string;\n  };\n}\n\nexport interface Category {\n  name: string;\n  slug: string;\n  description: string;\n  count: number;\n}\n\nexport interface GalleryImage {\n  url: string;\n  alt: string;\n  width?: number;\n  height?: number;\n  caption?: string;\n}\n\nexport interface BlogPost {\n  slug: string;\n  title: string;\n  excerpt: string;\n  content: string;\n  // true = MDX file (raw source, rendered via next-mdx-remote)\n  // false/undefined = MD file (compiled HTML string, rendered via dangerouslySetInnerHTML)\n  isMDX?: boolean;\n  date: string;\n  author: string;\n  tags?: string[];\n  image?: string;\n  imageAlt?: string;\n  imageWidth?: number;\n  imageHeight?: number;\n  imageCaption?: string;\n  readTime: number | string;\n  canonical: string;\n  updatedDate?: string;\n  category?: string;\n  dateModified?: string;\n  wordCount?: number;\n  galleryImages?: GalleryImage[];\n  topicalMap?: TopicalMap;\n  navigationContext?: NavigationContext;\n  topic?: string;\n  tldr?: TLDR;\n  faqItems?: FAQItem[];\n  tutorialMetadata?: TutorialMetadata;\n  videoMetadata?: VideoMetadata;\n  eventData?: {\n    name: string;\n    startDate: string;\n    endDate: string;\n    eventStatus: string;\n    eventAttendanceMode: string;\n    isVirtual: boolean;\n  };\n\n  template?: 'center' | 'split-left' | 'split-right' | 'grid';\n  heroImages?: string[];\n  carouselImages?: { url: string; alt: string }[];\n  products?: Product[];\n  coverImage: string;\n\n  // Controls whether the \"Explore {topic} inspiration gallery\" link is\n  // auto-injected after body images. Only relevant when `topic` is set.\n  // Defaults to true if omitted.\n  showInspoGalleryLink?: boolean;\n}"
