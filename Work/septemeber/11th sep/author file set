      "content": "// src/lib/authors.ts\n\nimport 'server-only';\nimport fs from 'fs';\nimport path from 'path';\nimport matter from 'gray-matter';\nimport { authors, resolveAuthor } from '@/data/authors';\nimport { Author, AuthorWithStats } from '@/types/author';\n\n// ─── Content directories to scan ─────────────────────────────────────────────\n\nconst CONTENT_DIRS: { dir: string; type: string; urlBase: string }[] = [\n  { dir: 'src/content/blogs',       type: 'blog',      urlBase: '/blog'          },\n  { dir: 'src/content/faqs',        type: 'faq',       urlBase: '/nail-faqs'     },\n  { dir: 'src/content/work-nails',  type: 'work-nail', urlBase: '/work-nails'    },\n  { dir: 'src/content/spotlights',  type: 'spotlight', urlBase: '/spotlight'     },\n  { dir: 'src/content/topics',      type: 'topic',     urlBase: '/topics'        },\n  { dir: 'src/content/reports',     type: 'report',    urlBase: '/trend-reports' },\n  { dir: 'src/content/business',    type: 'business',  urlBase: '/business'      },\n  { dir: 'src/content/pinterest',   type: 'pinterest', urlBase: '/pinterest'     },\n  { dir: 'src/content/salons',      type: 'salon',     urlBase: '/salons'        },\n];\n\n// ─── Helpers ─────────────────────────────────────────────────────────────────\n\nfunction getAllFilesRecursive(dir: string): string[] {\n  let results: string[] = [];\n  let entries: fs.Dirent[];\n\n  try {\n    entries = fs.readdirSync(dir, { withFileTypes: true });\n  } catch {\n    return [];\n  }\n\n  for (const entry of entries) {\n    const fullPath = path.join(dir, entry.name);\n    if (entry.isDirectory()) {\n      results = results.concat(getAllFilesRecursive(fullPath));\n    } else if (\n      entry.isFile() &&\n      (entry.name.endsWith('.md') || entry.name.endsWith('.mdx'))\n    ) {\n      results.push(fullPath);\n    }\n  }\n\n  return results;\n}\n\n// ─── Types ────────────────────────────────────────────────────────────────────\n\nexport interface AuthorPost {\n  slug: string;\n  title: string;\n  excerpt: string;\n  date: string;\n  image?: string;\n  type: string;\n  url: string;\n}\n\n// ─── Single-pass index (built once, shared by every author) ──────────────────\n//\n// PREVIOUS BEHAVIOUR (removed): getPostsByAuthor() scanned all 9 content\n// directories and read every file, per author, per call. With 2 authors that\n// meant 2 full repo scans just to build 3 static pages. This new version scans\n// the repo ONCE, buckets posts by resolved author while scanning, and caches\n// the result. getPostsByAuthor() and getAllAuthorsWithStats() both read from\n// this single cached index instead of triggering their own scans.\n\ninterface AuthorIndexEntry {\n  data: Map<string, AuthorPost[]>;\n  timestamp: number;\n}\n\nlet authorIndexCache: AuthorIndexEntry | null = null;\nconst INDEX_TTL = 3600000; // 1 hour\n\nfunction buildAuthorPostsIndex(): Map<string, AuthorPost[]> {\n  const index = new Map<string, AuthorPost[]>();\n\n  for (const { dir, type, urlBase } of CONTENT_DIRS) {\n    const absDir = path.join(process.cwd(), dir);\n    const files = getAllFilesRecursive(absDir);\n\n    for (const filePath of files) {\n      try {\n        const raw = fs.readFileSync(filePath, 'utf8');\n        const { data } = matter(raw);\n\n        // Fuzzy-resolve whatever string is in frontmatter (\"Ri\", \"Gaurav Verma\",\n        // \"ri-mirelle\", etc.) to a canonical Author.\n        const resolved = resolveAuthor(data.author);\n        if (!resolved) continue;\n\n        const relativePath = path.relative(absDir, filePath);\n        const urlPath = relativePath.replace(/\\.mdx?$/, '').replace(/\\\\/g, '/');\n        const slug = path.basename(filePath).replace(/\\.mdx?$/, '');\n\n        // Business URLs are built from frontmatter fields\n        const url = type === 'business'\n          ? `/business/${data.countrySlug}/${data.stateSlug}/${data.clientType}/${slug}`\n          : `${urlBase}/${urlPath}`;\n\n        const post: AuthorPost = {\n          slug,\n          title:   data.title   || 'Untitled',\n          excerpt: data.excerpt || '',\n          date:    data.date    || new Date().toISOString(),\n          image:   data.image   || undefined,\n          type,\n          url,\n        };\n\n        const existing = index.get(resolved.slug);\n        if (existing) {\n          existing.push(post);\n        } else {\n          index.set(resolved.slug, [post]);\n        }\n      } catch {\n        // skip unreadable files\n      }\n    }\n  }\n\n  // Sort each author's posts newest-first\n  for (const posts of index.values()) {\n    posts.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());\n  }\n\n  return index;\n}\n\nfunction getAuthorPostsIndex(): Map<string, AuthorPost[]> {\n  const now = Date.now();\n  if (!authorIndexCache || now - authorIndexCache.timestamp > INDEX_TTL) {\n    authorIndexCache = { data: buildAuthorPostsIndex(), timestamp: now };\n  }\n  return authorIndexCache.data;\n}\n\n// ─── Public API ───────────────────────────────────────────────────────────────\n\nexport function getAuthor(slug: string): Author | null {\n  return authors.find(a => a.slug === slug) ?? null;\n}\n\nexport function getAllAuthors(): Author[] {\n  return authors;\n}\n\nexport async function getPostsByAuthor(authorSlug: string): Promise<AuthorPost[]> {\n  const index = getAuthorPostsIndex();\n  return index.get(authorSlug) || [];\n}\n\nexport async function getAllAuthorsWithStats(): Promise<AuthorWithStats[]> {\n  const index = getAuthorPostsIndex();\n\n  return authors.map(author => ({\n    ...author,\n    postCount: (index.get(author.slug) || []).length,\n  }));\n}\n\nexport function clearAuthorCache(): void {\n  authorIndexCache = null;\n}"
