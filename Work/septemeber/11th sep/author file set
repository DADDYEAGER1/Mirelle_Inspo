      "content": "import type { NextConfig } from \"next\";\nimport fs from \"fs\";\nimport path from \"path\";\nimport matter from \"gray-matter\";\n\nimport staticRedirects from \"./redirects.json\";\n\n// ─── Blog redirect helper (config-safe, no server-only imports) ───────────────\n\nconst BLOG_DIRECTORY = path.join(process.cwd(), \"src/content/blogs\");\n\nfunction getAllBlogFilesRecursive(dir: string, base = \"\"): string[] {\n  let results: string[] = [];\n  let entries: fs.Dirent[];\n  try {\n    entries = fs.readdirSync(dir, { withFileTypes: true });\n  } catch {\n    return [];\n  }\n  for (const entry of entries) {\n    const relativePath = base ? `${base}/${entry.name}` : entry.name;\n    if (entry.isDirectory()) {\n      results = results.concat(\n        getAllBlogFilesRecursive(path.join(dir, entry.name), relativePath)\n      );\n    } else if (\n      entry.isFile() &&\n      (entry.name.endsWith(\".md\") || entry.name.endsWith(\".mdx\"))\n    ) {\n      results.push(relativePath);\n    }\n  }\n  return results;\n}\n\nfunction getBlogRedirects() {\n  try {\n    const files = getAllBlogFilesRecursive(BLOG_DIRECTORY);\n    return files\n      .map((relativePath) => {\n        const slug = path.basename(relativePath.replace(/\\.mdx?$/, \"\"));\n        const filePath = path.join(BLOG_DIRECTORY, relativePath);\n        const content = fs.readFileSync(filePath, \"utf8\");\n        const { data } = matter(content);\n        return { slug, topic: data.topic as string | undefined };\n      })\n      .filter((post): post is { slug: string; topic: string } => !!post.topic)\n      .map((post) => ({\n        source: `/blog/${post.slug}`,\n        destination: `/blog/${post.topic}/${post.slug}`,\n        permanent: true,\n      }));\n  } catch (err) {\n    console.error(\"Failed to generate blog redirects:\", err);\n    return [];\n  }\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst nextConfig: NextConfig = {\n  // ✅ Image Optimization (disabled - unoptimized: true, so images are served as-is)\n  images: {\n    unoptimized: true,\n    dangerouslyAllowSVG: true,\n    contentDispositionType: \"attachment\",\n    contentSecurityPolicy: \"default-src 'self'; script-src 'none'; sandbox;\",\n  },\n\n  // ✅ Headers\n  async headers() {\n    return [\n      {\n        source: \"/((?!api|_next/static|_next/image|favicon.ico).*)\",\n        headers: [\n          {\n            key: \"Cache-Control\",\n            value: \"public, max-age=2592000\",\n          },\n        ],\n      },\n      {\n        source: \"/:path*\",\n        headers: [\n          { key: \"X-Content-Type-Options\", value: \"nosniff\" },\n          { key: \"X-Frame-Options\", value: \"SAMEORIGIN\" },\n          { key: \"X-XSS-Protection\", value: \"1; mode=block\" },\n          {\n            key: \"Referrer-Policy\",\n            value: \"strict-origin-when-cross-origin\",\n          },\n          {\n            key: \"Permissions-Policy\",\n            value: \"camera=(), microphone=(), geolocation=()\",\n          },\n        ],\n      },\n      {\n        source: \"/images/:path*\",\n        headers: [\n          {\n            key: \"Cache-Control\",\n            value: \"public, max-age=2592000\",\n          },\n        ],\n      },\n      {\n        source: \"/_next/static/:path*\",\n        headers: [\n          {\n            key: \"Cache-Control\",\n            value: \"public, max-age=31536000, immutable\",\n          },\n        ],\n      },\n    ];\n  },\n\n  compress: true,\n  generateEtags: true,\n  trailingSlash: false,\n  reactStrictMode: true,\n\n  experimental: {\n    optimizePackageImports: [\"lodash-es\", \"fuse.js\"],\n    optimizeCss: true,\n  },\n\n  // ─────────────────────────────────────────────────────────────────────\n  // Fix: /authors and /authors/[slug] were bundling ALL of src/content/\n  // (blogs, faqs, work-nails, spotlights, topics, reports, business  -\n  // thousands of files) into their Vercel Function output, blowing past\n  // the 250MB uncompressed function-size limit (285.63MB observed).\n  //\n  // Why: getPostsByAuthor() / getAllAuthorsWithStats() in src/lib/authors.ts\n  // recursively fs.readdirSync()'s every content directory to find posts\n  // matching an author's slug. Next's build tracer can't statically prove\n  // which files that dynamic traversal will touch, so it conservatively\n  // includes the entire src/content/ tree in the function bundle.\n  //\n  // Safe to exclude because: both routes use `dynamic = 'force-static'`\n  // and `revalidate = false` - they are fully prerendered to HTML at\n  // build time and never need runtime filesystem access to src/content/\n  // after the build completes. This only trims the deployed function\n  // bundle; the build step itself still has full fs access.\n  //\n  // NOTE: outputFileTracingExcludes is a STABLE top-level config key as of\n  // Next.js 15 (moved out of `experimental`). Do not nest it back inside\n  // `experimental` - TypeScript will reject it (ExperimentalConfig no\n  // longer includes this property).\n  // ─────────────────────────────────────────────────────────────────────\n  outputFileTracingExcludes: {\n    \"/authors\": [\"./src/content/**/*\"],\n    \"/authors/[slug]\": [\"./src/content/**/*\"],\n  },\n\n  webpack: (config, { isServer, dev }) => {\n    if (!isServer && !dev) {\n      config.optimization = {\n        ...config.optimization,\n        splitChunks: {\n          chunks: \"all\",\n          cacheGroups: {\n            default: false,\n            vendors: false,\n            vendor: {\n              name: \"vendor\",\n              chunks: \"all\",\n              test: /node_modules/,\n              priority: 20,\n            },\n            common: {\n              name: \"common\",\n              minChunks: 2,\n              chunks: \"all\",\n              priority: 10,\n              reuseExistingChunk: true,\n              enforce: true,\n            },\n            lib: {\n              test: /[\\\\/]node_modules[\\\\/](react|react-dom|next)[\\\\/]/,\n              name: \"lib\",\n              chunks: \"all\",\n              priority: 30,\n            },\n          },\n        },\n        minimize: true,\n      };\n    }\n\n    config.module.rules.push({\n      test: /\\.svg$/,\n      use: [\"@svgr/webpack\"],\n    });\n\n    return config;\n  },\n\n  productionBrowserSourceMaps: false,\n\n  // ✅ Redirects (301)\n  async redirects() {\n    return [\n      // Journey by Mediavine ads.txt\n      { source: \"/ads.txt\", destination: \"https://adstxt.journeymv.com/sites/d965deec-2fc5-4c1b-86c5-8c7c99848f4a/ads.txt\", permanent: false },\n\n      ...staticRedirects,\n\n      // Dynamic blog slug → topic/slug redirects (frontmatter-driven)\n      ...getBlogRedirects(),\n    ];\n  },\n};\n\nexport default nextConfig;"
    }
